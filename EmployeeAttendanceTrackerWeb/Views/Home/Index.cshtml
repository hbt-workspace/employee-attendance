@model EmployeeAttendanceTrackerWeb.Models.ViewModels.DashboardViewModel;

@{
    ViewData["Title"] = "Dashboard";
}

<div>
    <!-- DASHBOARD WELCOME -->

    <div class="row mb-4">
        <div class="col-12">
            <h3 class="font-weight-bold">Welcome back!</h3>
            <p class="text-muted mb-0">
                Here's your employee attendance overview for
                @DateTime.Now.ToString("dddd, dd MMMM yyyy").
            </p>
        </div>
    </div>

    <!-- ATTENDANCE SUMMARY CARDS -->
    <div class="row">

        <!-- Total Employees -->
        <div class="col-xl-4 col-sm-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-8">
                            <h3 class="mb-0">@Model.TotalEmployees</h3>
                            <h6 class="text-muted font-weight-normal mt-2">
                                Total Employees
                            </h6>
                        </div>
                        <div class="col-4">
                            <div class="icon icon-box-primary">
                                <span class="mdi mdi-account-group icon-item"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Present Today -->
        <div class="col-xl-4 col-sm-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-8">
                            <h3 class="mb-0">@Model.PresentToday</h3>
                            <h6 class="text-muted font-weight-normal mt-2">
                                Present Today
                            </h6>
                        </div>
                        <div class="col-4">
                            <div class="icon icon-box-success">
                                <span class="mdi mdi-account-check icon-item"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Absent Today -->
        <div class="col-xl-4 col-sm-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-8">
                            <h3 class="mb-0">@Model.AbsentToday</h3>
                            <h6 class="text-muted font-weight-normal mt-2">
                                Absent Today
                            </h6>
                        </div>
                        <div class="col-4">
                            <div class="icon icon-box-danger">
                                <span class="mdi mdi-account-remove icon-item"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>  

    <!-- TODAY'S ATTENDANCE -->

    <div class="row">

        <div class="col-md-5 col-xl-4 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">

                    <h4 class="card-title">Today's Attendance</h4>
                    <p class="text-muted small">
                        Daily attendance distribution
                    </p>

                    <div style="height: 260px;">
                        <canvas id="todayAttendanceChart"
                                data-labels='@System.Text.Json.JsonSerializer.Serialize(Model.TodayChartLabels)'
                                data-values='@System.Text.Json.JsonSerializer.Serialize(Model.TodayChartData)'>
                        </canvas>
                    </div>

                    <div class="d-flex justify-content-around mt-3">
                        <div class="text-center">
                            <h5 class="mb-1">
                                @(Model.TotalEmployees > 0
                                    ? Math.Round((double)Model.PresentToday / Model.TotalEmployees * 100, 1)
                                    : 0)%
                            </h5>
                            <p class="text-muted small mb-0">Attendance Rate</p>
                        </div>
                        <div class="text-center">
                            <h5 class="mb-1">@Model.TotalEmployees</h5>
                            <p class="text-muted small mb-0">Total Employees</p>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- 04. WEEKLY ATTENDANCE -->
        <div class="col-md-7 col-xl-8 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">

                    <h4 class="card-title">Weekly Attendance </h4>
                    <p class="text-muted small">
                        Present vs Absent employees
                    </p>

                    <div style="height: 310px;">
                        <canvas id="weeklyAttendanceChart"
                                data-labels='@System.Text.Json.JsonSerializer.Serialize(Model.WeeklyLabels)'
                                data-present='@System.Text.Json.JsonSerializer.Serialize(Model.WeeklyPresentData)'
                                data-absent='@System.Text.Json.JsonSerializer.Serialize(Model.WeeklyAbsentData)'>
                        </canvas>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>