<Window x:Class="EmployeeAttendanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="\Assets\attendance_tracker.ico"
        Title="Employee Attendance"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F4F7FC"
        BorderThickness="0"
        FontFamily="Segoe UI"
        Foreground="#17243B">

        <Window.Resources>

                <SolidColorBrush x:Key="PageBackground"
                                 Color="#F4F7FC"/>
                <SolidColorBrush x:Key="SidebarBackground"
                                 Color="#15243B"/>
                <SolidColorBrush x:Key="CardBackground"
                                 Color="#FFFFFF"/>
                <SolidColorBrush x:Key="PrimaryColor"
                                 Color="#2864E8"/>
                <SolidColorBrush x:Key="SecondaryText"
                                 Color="#74829A"/>
                <SolidColorBrush x:Key="BorderColor"
                                 Color="#E5EAF2"/>

                <!-- Sidebar navigation buttons -->
                <Style x:Key="NavigationButtonStyle"
                       TargetType="Button">
                        <Setter Property="Height"
                                Value="48"/>
                        <Setter Property="Margin"
                                Value="0,0,0,8"/>
                        <Setter Property="Padding"
                                Value="16,0"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Left"/>
                        <Setter Property="Foreground"
                                Value="#C7D3E5"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>

                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="9"
                                                        Padding="{TemplateBinding Padding}">

                                                        <ContentPresenter
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#243A5A"/>
                                                                <Setter Property="Foreground"
                                                                        Value="White"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Dashboard cards -->
                <Style x:Key="CardStyle"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="White"/>
                        <Setter Property="BorderBrush"
                                Value="#E5EAF2"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="CornerRadius"
                                Value="14"/>
                        <Setter Property="Padding"
                                Value="20"/>
                </Style>

                <!-- DataGrid headers -->
                <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="#E8EEFA"/>
                        <Setter Property="Foreground"
                                Value="#1D3F78"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="FontSize"
                                Value="11"/>
                        <Setter Property="Padding"
                                Value="12,12"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Left"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="BorderBrush"
                                Value="#D7E1F2"/>
                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>
                </Style>

                <!-- DataGrid cells -->
                <Style TargetType="DataGridCell">
                        <Setter Property="Padding"
                                Value="12,12"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Left"/>
                </Style>


                <!-- DataGrid rows -->
                <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight"
                                Value="52"/>
                        <Setter Property="Background"
                                Value="White"/>
                        <Setter Property="Foreground"
                                Value="#26364F"/>
                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>
                        <Setter Property="BorderBrush"
                                Value="#EDF0F5"/>

                        <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                        <Setter Property="Background"
                                                Value="#F0F5FF"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

                <!-- Custom title bar buttons -->
                <Style x:Key="WindowControlButtonStyle"
                       TargetType="Button">
                        <Setter Property="Width"
                                Value="44"/>
                        <Setter Property="Height"
                                Value="36"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="FontSize"
                                Value="17"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Focusable"
                                Value="False"/>

                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ControlBorder"
                                                        Background="{TemplateBinding Background}">
                                                        <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ControlBorder"
                                                                        Property="Background"
                                                                        Value="#30415C"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Close button hover effect -->
                <Style x:Key="CloseWindowButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource WindowControlButtonStyle}">

                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseBorder"
                                                        Background="{TemplateBinding Background}">
                                                        <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="CloseBorder"
                                                                        Property="Background"
                                                                        Value="#C42B1C"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Attendance report header alignment -->
                <Style x:Key="AttendanceReportHeaderStyle"
                       TargetType="{x:Type DataGridColumnHeader}"
                       BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                </Style>

                <!-- Left-align only the Employee Name heading -->
                <Style x:Key="AttendanceEmployeeNameHeaderStyle"
                       TargetType="{x:Type DataGridColumnHeader}"
                       BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Left"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="Padding"
                                Value="12,12"/>
                </Style>

                <!-- PRESENT: bold green heading -->
                <Style x:Key="PresentHeaderStyle"
                       TargetType="{x:Type DataGridColumnHeader}"
                       BasedOn="{StaticResource AttendanceReportHeaderStyle}">
                        <Setter Property="Foreground"
                                        Value="#12A66A"/>
                        <Setter Property="FontWeight"
                                        Value="Bold"/>
                </Style>

                <!-- ABSENT: bold red heading -->
                <Style x:Key="AbsentHeaderStyle"
                       TargetType="{x:Type DataGridColumnHeader}"
                       BasedOn="{StaticResource AttendanceReportHeaderStyle}">
                        <Setter Property="Foreground"
                                        Value="#DC3545"/>
                        <Setter Property="FontWeight"
                                        Value="Bold"/>
                </Style>

                <!-- WORKING DAYS: bold orange heading -->
                <Style x:Key="WorkingDaysHeaderStyle"
                       TargetType="{x:Type DataGridColumnHeader}"
                       BasedOn="{StaticResource AttendanceReportHeaderStyle}">
                        <Setter Property="Foreground"
                                        Value="#E58B28"/>
                        <Setter Property="FontWeight"
                                        Value="Bold"/>
                </Style>

        </Window.Resources>

        <Grid x:Name="RootGrid"
              Background="#F4F7FC"
              ClipToBounds="True">

                <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CUSTOM TITLE BAR-->
                <Border Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Background="#15243B"
                        Padding="18,0"
                        BorderThickness="0">

                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- App branding and draggable title area -->
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Cursor="SizeAll"
                                            MouseLeftButtonDown="Header_MouseLeftButtonDown">

                                        <!-- HBT Logo -->
                                        <Border Width="42"
                                                Height="42"
                                                CornerRadius="10"
                                                Background="White"
                                                Padding="3"
                                                VerticalAlignment="Center">

                                                <Image Source="/Assets/HBTLogo.ico"
                                                       Stretch="Uniform"/>
                                        </Border>

                                        <StackPanel Margin="10,0,0,0"
                                                    VerticalAlignment="Center">

                                                <TextBlock Text="HBT WorkSpace"
                                                           Foreground="#A9B8CF"
                                                           FontSize="16"
                                                           FontWeight="Bold"/>
                                        </StackPanel>
                                </StackPanel>

                                <!-- Minimize, maximize/restore, close -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                        <Button Content="—"
                                                Style="{StaticResource WindowControlButtonStyle}"
                                                ToolTip="Minimize"
                                                Click="MinimizeButton_Click"/>

                                        <Button x:Name="MaximizeButton"
                                                Content="❐"
                                                Style="{StaticResource WindowControlButtonStyle}"
                                                ToolTip="Restore Down"
                                                Click="MaximizeButton_Click"/>

                                        <Button Content="✕"
                                                Style="{StaticResource CloseWindowButtonStyle}"
                                                ToolTip="Close"
                                                Click="CloseButton_Click"/>
                                </StackPanel>
                        </Grid>
                </Border>

                <!-- SIDEBAR -->

                <Border x:Name="SidebarBorder"
                        Grid.Row="1"
                        Grid.Column="0"
                        Background="{StaticResource SidebarBackground}">

                        <DockPanel Margin="18">

                                <!-- Sidebar header and navigation -->
                                <StackPanel DockPanel.Dock="Top">

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="4,12,0,42">

                                                <!-- Employee Attendance Icon -->
                                                <Border Width="46"
                                                        Height="46"
                                                        CornerRadius="13"
                                                        Background="#2864E8"
                                                        VerticalAlignment="Center">

                                                        <Viewbox Width="25"
                                                                 Height="25"
                                                                 Stretch="Uniform">
                                                                <Canvas Width="24"
                                                                        Height="24">

                                                                        <!-- Shield -->
                                                                        <Path Data="M12,2 L21,6 L21,13 C21,18 17,21 12,23 C7,21 3,18 3,13 L3,6 Z"
                                                                              Stroke="White"
                                                                              StrokeThickness="1.8"
                                                                              Fill="Transparent"
                                                                              StrokeLineJoin="Round"/>

                                                                        <!-- Check mark -->
                                                                        <Path Data="M7,12 L10,15 L17,9"
                                                                              Stroke="White"
                                                                              StrokeThickness="2"
                                                                              Fill="Transparent"
                                                                              StrokeLineJoin="Round"/>
                                                                </Canvas>
                                                        </Viewbox>
                                                </Border>

                                                <StackPanel Margin="12,1,0,0"
                                                            VerticalAlignment="Center">

                                                        <TextBlock Text="HBT WorkSpace"
                                                                   Foreground="White"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"/>

                                                        <TextBlock Text="EMPLOYEE ATTENDANCE TRACKER"
                                                                   Foreground="#9EB0CA"
                                                                   FontSize="9"
                                                                   Margin="0,3,0,0"/>
                                                </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="WORKSPACE"
                                                   Foreground="#8295B2"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="10,0,0,14"/>

                                        <Button x:Name="DashboardNavButton"
                                                Content="⌂    Dashboard"
                                                Tag="Dashboard"
                                                Click="NavigationButton_Click"
                                                Style="{StaticResource NavigationButtonStyle}"
                                                Background="#2864E8"
                                                Foreground="White"/>

                                        <Button x:Name="AttendanceReportNavButton"
                                                Content="▤    Attendance"
                                                Tag="AttendanceReport"
                                                Click="NavigationButton_Click"
                                                Style="{StaticResource NavigationButtonStyle}"/>

                                        <Button x:Name="AttendanceNavButton"
                                                Content="◷    History"
                                                Tag="Attendance"
                                                Click="NavigationButton_Click"
                                                Style="{StaticResource NavigationButtonStyle}"/>

                                        <Button x:Name="EmployeesNavButton"
                                                Content="♙    Employees"
                                                Tag="Employees"
                                                Click="NavigationButton_Click"
                                                Style="{StaticResource NavigationButtonStyle}"/>

                                </StackPanel>

                                <!-- Sidebar footer -->
                                <StackPanel DockPanel.Dock="Bottom">

                                        <Separator Background="#30415C"
                                                   Margin="0,0,0,14"/>

                                        <TextBlock Text="LIGHT THEME"
                                                   Foreground="#8295B2"
                                                   FontSize="10"
                                                   Margin="10,12,0,8"/>

                                        <TextBlock Text="HBTW  •  VERSION 1.0"
                                                   Foreground="#8295B2"
                                                   FontSize="9"
                                                   Margin="10,16,0,5"/>

                                        <TextBlock Text="Employee Attendance Tracker"
                                                   Foreground="#A8B8CD"
                                                   FontSize="10"
                                                   Margin="10,0,0,8"/>
                                </StackPanel>

                        </DockPanel>
                </Border>

                <!-- MAIN CONTENT -->

                <Grid Grid.Row="1"
                      Grid.Column="1"
                      Margin="30,24,30,24">

                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Main page heading and actions -->
                        <Grid Grid.Row="0"
                              Margin="0,0,0,25">

                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                        <TextBlock x:Name="PageTitle"
                                                   Text="Dashboard"
                                                   FontSize="30"
                                                   FontWeight="Bold"
                                                   Foreground="#17243B"/>

                                        <TextBlock x:Name="PageSubtitle"
                                                   Text="Overview of employee attendance"
                                                   FontSize="13"
                                                   Foreground="#74829A"
                                                   Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                        <!-- Search box with icon -->
                                        <Border Grid.Column="0"
                                                Width="215"
                                                Height="40"
                                                Margin="0,0,14,0"
                                                Background="White"
                                                BorderBrush="#D5DDEB"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                VerticalAlignment="Center">

                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Search icon -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="⌕"
                                                                   FontSize="23"
                                                                   Foreground="#74829A"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Search input -->
                                                        <TextBox x:Name="SearchTextBox"
                                                                 Grid.Column="1"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 Padding="0,5,8,5"
                                                                 VerticalContentAlignment="Center"
                                                                 ToolTip="Search employees or attendance"
                                                                 TextChanged="SearchTextBox_TextChanged"/>
                                                </Grid>
                                        </Border>

                                        <TextBlock x:Name="TodayText"
                                                   VerticalAlignment="Center"
                                                   Foreground="#53627B"
                                                   Margin="0,0,16,0"/>

                                        <Button x:Name="RefreshButton"
                                                Grid.Column="2"
                                                Content="↻  Refresh"
                                                Click="RefreshButton_Click"
                                                Width="104"
                                                Height="40"
                                                Padding="10,0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Background="#2864E8"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"/>
                                </StackPanel>
                        </Grid>

                        <!-- PAGE VIEWS-->
                        <Grid Grid.Row="1">

                                <!-- DASHBOARD -->
                                <Grid x:Name="DashboardPanel">

                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Summary cards -->
                                        <UniformGrid Grid.Row="0"
                                                     Columns="4"
                                                     Margin="0,0,0,24">

                                                <Border Style="{StaticResource CardStyle}"
                                                        Margin="0,0,12,0">

                                                        <StackPanel>
                                                                <TextBlock Text="TOTAL EMPLOYEES"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#74829A"/>

                                                                <TextBlock x:Name="TotalEmployeesText"
                                                                           Text="—"
                                                                           FontSize="34"
                                                                           FontWeight="Bold"
                                                                           Foreground="#2864E8"
                                                                           Margin="0,12,0,4"/>

                                                                <TextBlock Text="Registered employees"
                                                                           FontSize="11"
                                                                           Foreground="#8B98AC"/>
                                                        </StackPanel>
                                                </Border>

                                                <Border Style="{StaticResource CardStyle}"
                                                        Margin="0,0,12,0">

                                                        <StackPanel>
                                                                <TextBlock Text="PRESENT TODAY"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#74829A"/>

                                                                <TextBlock x:Name="PresentTodayText"
                                                                           Text="—"
                                                                           FontSize="34"
                                                                           FontWeight="Bold"
                                                                           Foreground="#12A66A"
                                                                           Margin="0,12,0,4"/>

                                                                <TextBlock Text="Attendance recorded"
                                                                           FontSize="11"
                                                                           Foreground="#8B98AC"/>
                                                        </StackPanel>
                                                </Border>

                                                <Border Style="{StaticResource CardStyle}"
                                                        Margin="0,0,12,0">

                                                        <StackPanel>
                                                                <TextBlock Text="ABSENT TODAY"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#74829A"/>

                                                                <TextBlock x:Name="AbsentTodayText"
                                                                           Text="—"
                                                                           FontSize="34"
                                                                           FontWeight="Bold"
                                                                           Foreground="#E58B28"
                                                                           Margin="0,12,0,4"/>

                                                                <TextBlock Text="No attendance record"
                                                                           FontSize="11"
                                                                           Foreground="#8B98AC"/>
                                                        </StackPanel>
                                                </Border>

                                                <Border Style="{StaticResource CardStyle}">

                                                        <StackPanel>
                                                                <TextBlock Text="LATEST LOGIN"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#74829A"/>

                                                                <TextBlock x:Name="LatestLoginText"
                                                                           Text="—"
                                                                           FontSize="27"
                                                                           FontWeight="Bold"
                                                                           Foreground="#7655D9"
                                                                           Margin="0,12,0,4"/>

                                                                <TextBlock x:Name="LatestEmployeeText"
                                                                           Text="Waiting for data"
                                                                           FontSize="11"
                                                                           Foreground="#8B98AC"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                </Border>

                                        </UniformGrid>

                                        <!-- Recent attendance heading -->
                                        <Grid Grid.Row="1"
                                              Margin="0,0,0,15">

                                                <StackPanel>
                                                        <TextBlock Text="Today's attendance"
                                                                   FontSize="20"
                                                                   FontWeight="Bold"
                                                                   Foreground="#17243B"/>

                                                        <TextBlock x:Name="AttendanceCountText"
                                                                   Text="Loading records..."
                                                                   FontSize="12"
                                                                   Foreground="#74829A"
                                                                   Margin="0,5,0,0"/>
                                                </StackPanel>
                                        </Grid>

                                        <!-- Recent attendance table -->
                                        <Border Grid.Row="2"
                                                Background="White"
                                                CornerRadius="14"
                                                BorderBrush="#E5EAF2"
                                                BorderThickness="1"
                                                Padding="12">

                                                <DockPanel>

                                                        <TextBlock x:Name="LoadingText"
                                                                   DockPanel.Dock="Bottom"
                                                                   Foreground="#74829A"
                                                                   Margin="5,8,5,0"/>

                                                        <DataGrid x:Name="AttendanceGrid"
                                                                  AutoGenerateColumns="False"
                                                                  IsReadOnly="True"
                                                                  CanUserAddRows="False"
                                                                  CanUserDeleteRows="False"
                                                                  HeadersVisibility="Column"
                                                                  GridLinesVisibility="Horizontal"
                                                                  HorizontalGridLinesBrush="#EDF0F5"
                                                                  BorderThickness="0"
                                                                  MinRowHeight="48"
                                                                  ColumnHeaderHeight="48"
                                                                  Background="White"
                                                                  AlternatingRowBackground="#FAFBFE"
                                                                  AlternationCount="10000">

                                                                <DataGrid.Columns>

                                                                        <!-- Serial Number -->
                                                                        <DataGridTextColumn Header="#"
                                                                                            Binding="{Binding SerialNumber}"
                                                                                            Width="50"
                                                                                            IsReadOnly="True"/>

                                                                        <!-- Employee Name -->
                                                                        <DataGridTextColumn Header="EMPLOYEE NAME"
                                                                                            Binding="{Binding EmployeeName}"
                                                                                            Width="1.5*"/>

                                                                        <!-- Attendance Date -->
                                                                        <DataGridTextColumn Header="DATE"
                                                                                            Binding="{Binding AttendanceDate, StringFormat={}{0:dd MMM yyyy}}"
                                                                                            Width="1.1*"/>

                                                                        <!-- Login Time -->
                                                                        <DataGridTextColumn Header="LOGIN TIME"
                                                                                            Binding="{Binding LoginTime, StringFormat={}{0:hh:mm:ss tt}}"
                                                                                            Width="1.2*"/>

                                                                        <!-- IP Address -->
                                                                        <DataGridTextColumn Header="IP ADDRESS"
                                                                                            Binding="{Binding IPAddress}"
                                                                                            Width="1.5*"/>

                                                                </DataGrid.Columns>

                                                        </DataGrid>

                                                </DockPanel>

                                        </Border>
                                </Grid>


                                <!-- NEW ATTENDANCE SUMMARY PAGE -->
                                <Grid x:Name="AttendanceReportPanel"
                                      Visibility="Collapsed">

                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Period filter -->
                                        <ComboBox x:Name="AttendanceReportDateFilter"
                                                  Grid.Row="0"
                                                  Width="190"
                                                  Height="40"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,0,0,14"
                                                  SelectionChanged="AttendanceReportDateFilter_SelectionChanged"
                                                  SelectedIndex="0">

                                                <ComboBoxItem Content="All days"/>
                                                <ComboBoxItem Content="This week"/>
                                                <ComboBoxItem Content="This month"/>
                                                <ComboBoxItem Content="Last month"/>
                                        </ComboBox>

                                        <!-- One row per employee -->
                                        <Border Grid.Row="1"
                                                Background="White"
                                                CornerRadius="14"
                                                BorderBrush="#E5EAF2"
                                                BorderThickness="1"
                                                Padding="12">

                                                <DataGrid x:Name="AttendanceReportGrid"
                                                          ColumnHeaderStyle="{StaticResource AttendanceReportHeaderStyle}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          MinRowHeight="48"
                                                          ColumnHeaderHeight="48"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="#EDF0F5"
                                                          BorderThickness="0"
                                                          Background="White"
                                                          AlternatingRowBackground="#FAFBFE">


                                                        <DataGrid.Columns>

                                                                <DataGridTextColumn Header="EMPLOYEE NAME"
                                                                                    HeaderStyle="{StaticResource AttendanceEmployeeNameHeaderStyle}"
                                                                                    Binding="{Binding EmployeeName}"
                                                                                    Width="2*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="{x:Type TextBlock}">
                                                                                        <Setter Property="VerticalAlignment"
                                                                                                Value="Center"/>
                                                                                        <Setter Property="HorizontalAlignment"
                                                                                                Value="Left"/>
                                                                                        <Setter Property="TextAlignment"
                                                                                                Value="Center"/>
                                                                                        <Setter Property="Margin"
                                                                                                Value="2,0,0,0"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <DataGridTextColumn Header="PRESENT"
                                                                                    Binding="{Binding PresentDays}"
                                                                                    HeaderStyle="{StaticResource PresentHeaderStyle}"
                                                                                    Width="*">
                                                                        <DataGridTextColumn.ElementStyle >
                                                                                <Style TargetType="{x:Type TextBlock}" >
                                                                                        <Setter Property="Foreground"
                                                                                                        Value="#12A66A"/>
                                                                                        <Setter Property="FontWeight"
                                                                                                Value="Bold"/>
                                                                                        <Setter Property="HorizontalAlignment"
                                                                                                Value="Center"/>
                                                                                        <Setter Property="TextAlignment"
                                                                                                Value="Center"/>
                                                                                        <Setter Property="VerticalAlignment"
                                                                                                Value="Center"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <DataGridTextColumn Header="ABSENT"
                                                                                    Binding="{Binding AbsentDays}"
                                                                                    HeaderStyle="{StaticResource AbsentHeaderStyle}"
                                                                                    Width="*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="{x:Type TextBlock}">
                                                                                        <Setter Property="Foreground"
                                                                                                Value="#DC3545"/>
                                                                                        <Setter Property="FontWeight"
                                                                                                Value="Bold"/>
                                                                                        <Setter Property="HorizontalAlignment"
                                                                                                Value="Center"/>
                                                                                        <Setter Property="TextAlignment"
                                                                                                Value="Center"/>
                                                                                        <Setter Property="VerticalAlignment"
                                                                                                Value="Center"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <DataGridTextColumn Header="WORKING DAYS"
                                                                                    Binding="{Binding WorkingDays}"
                                                                                    HeaderStyle="{StaticResource WorkingDaysHeaderStyle}"
                                                                                    Width="1.2*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="{x:Type TextBlock}">
                                                                                        <Setter Property="Foreground"
                                                                                                Value="#E58B28"/>
                                                                                        <Setter Property="FontWeight"
                                                                                                Value="Bold"/>
                                                                                        <Setter Property="HorizontalAlignment"
                                                                                                Value="Center"/>
                                                                                        <Setter Property="TextAlignment"
                                                                                                Value="Center"/>
                                                                                        <Setter Property="VerticalAlignment"
                                                                                                Value="Center"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                        </DataGrid.Columns>

                                                </DataGrid>
                                        </Border>
                                </Grid>



                                <!-- ATTENDANCE HISTORY -->
                                <Grid x:Name="AttendancePanel"
                                      Visibility="Collapsed">

                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox x:Name="DateFilter"
                                                  Grid.Row="0"
                                                  Width="190"
                                                  Height="40"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,0,0,14"
                                                  SelectionChanged="DateFilter_SelectionChanged"
                                                  SelectedIndex="0">

                                                <ComboBoxItem Content="All dates"/>
                                                <ComboBoxItem Content="Today"/>
                                                <ComboBoxItem Content="Last 7 days"/>
                                                <ComboBoxItem Content="Last 30 days"/>
                                        </ComboBox>

                                        <Border Grid.Row="1"
                                                Background="White"
                                                CornerRadius="14"
                                                BorderBrush="#E5EAF2"
                                                BorderThickness="1"
                                                Padding="12">

                                                <DataGrid x:Name="HistoryGrid"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          MinRowHeight="48"
                                                          ColumnHeaderHeight="48"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="#EDF0F5"
                                                          BorderThickness="0"
                                                          Background="White"
                                                          AlternatingRowBackground="#FAFBFE">

                                                        <DataGrid.Columns>

                                                                <DataGridTextColumn
                                                                        Header="EMPLOYEE NAME"
                                                                        Binding="{Binding EmployeeName}"
                                                                        Width="1.4*"/>

                                                                <DataGridTextColumn
                                                                        Header="DATE"
                                                                        Binding="{Binding AttendanceDate, StringFormat={}{0:dd MMM yyyy}}"
                                                                        Width="1.1*"/>

                                                                <DataGridTextColumn
                                                                        Header="LOGIN TIME"
                                                                        Binding="{Binding LoginTime, StringFormat={}{0:hh:mm:ss tt}}"
                                                                        Width="1.2*"/>

                                                                <DataGridTextColumn
                                                                        Header="IP ADDRESS"
                                                                        Binding="{Binding IPAddress}"
                                                                        Width="1.5*"/>

                                                        </DataGrid.Columns>
                                                </DataGrid>
                                        </Border>
                                </Grid>

                                <!-- EMPLOYEES -->
                                <Grid x:Name="EmployeesPanel"
                                      Visibility="Collapsed">

                                        <Border Background="White"
                                                CornerRadius="14"
                                                BorderBrush="#E5EAF2"
                                                BorderThickness="1"
                                                Padding="12">

                                                <DataGrid x:Name="EmployeesGrid"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          MinRowHeight="48"
                                                          ColumnHeaderHeight="48"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="#EDF0F5"
                                                          BorderThickness="0"
                                                          Background="White"
                                                          AlternatingRowBackground="#FAFBFE">

                                                        <DataGrid.Columns>

                                                                <DataGridTextColumn
                                                                        Header="#"
                                                                        Binding="{Binding SerialNumber}"
                                                                        Width="60"/>

                                                                <DataGridTextColumn
                                                                        Header="EMPLOYEE NAME"
                                                                        Binding="{Binding UserName}"
                                                                        Width="2*"/>

                                                                <DataGridTextColumn
                                                                        Header="ACCOUNT STATUS"
                                                                        Binding="{Binding Status}"
                                                                        Width="1.3*"/>

                                                        </DataGrid.Columns>
                                                </DataGrid>
                                        </Border>
                                </Grid>
                        </Grid>
                </Grid>
        </Grid>
</Window>